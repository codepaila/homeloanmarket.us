// ============================================================
// Testimonials
// ============================================================

model Testimonial {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  photo        String?
  rating       Int
  comment      String
  city         String?
  propertyType String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("testimonials")
