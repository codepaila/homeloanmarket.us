model LoanProduct {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  bankId        String   @db.ObjectId
  name          String
  description   String?
  interestRate  Float // e.g. 8.5 for 8.5%
  processingFee Float? // percentage or flat
  maxAmount     Float?
  maxTenure     Int? // months
