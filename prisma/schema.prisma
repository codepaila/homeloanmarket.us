  isFeatured   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([propertyType])
  @@index([isFeatured])
  @@map("properties")
}

// ============================================================
// Blog System
// ============================================================

model BlogPost {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImage     String?
  author         String
  tags           String[]
  category       String
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
